# petronet.mn — PetroNet.
#
# Жинхэнэ файл нь серверийн /opt/petronet/.env бөгөөд нууц утгуудтай тул энд
# хэзээ ч commit хийгдэхгүй (.gitignore). Энэ нь тэр файлын хэлбэр.
# deploy.sh нь үүнийг deploy/.env рүү хуулж, compose тэндээс уншина.

# --------------------------------------------------------------- энэ стек
# Портууд нь ЦӨМИЙН АНХДАГЧ БИШ (5440 / 8098 / 3018, бүгд зөвхөн loopback) —
# deploy/docker-compose.yml болон nginx/petronet.mn.conf дотор бичээстэй.
# Шалтгаан нь энэ стек fuelnet.gerege.mn-тэй ижил машин дээр сууж байгаа явдал.
PETRONET_POSTGRES_PASSWORD=

# Production дээр үүнгүйгээр сервер асахаас татгалзана (ValidateProduction).
# Энэ бол энэ суулгацын өөрийн built-in клиентийн нууц.
SSO_DEFAULT_CLIENT_SECRET=

# --------------------------------------------------------------------- образ
# Бүрхүүлийн образ.
#
# Энэ бүтээгдэхүүн frontend-ээ ӨӨРӨӨ зөөдөг — газрын зураг, ШТС, бааз,
# ваучерын дэлгэцүүд. Тиймээс цөмийн нийтэлсэн образ энд тохирохгүй: тэр нь
# эдгээр хуудсыг мэдэхгүй бөгөөд газрын зураг «байхгүй хуудас» болно.
# `deploy.sh` бүрхүүлийг хостод `frontend/`-ээс барина.
WEB_IMAGE=petronet-web:latest

# --------------------------------------------------------------------- домэйн
# ------------------------------------------------------------------ цагийн бүс
# Энэ стекийн хана цаг. Postgres ба Go процесс хоёулаа үүнийг барина — хоёр нь
# өөр цагтай байвал `CURRENT_DATE` (иргэний өдрийн эрх, ваучерын өдөр) болон
# `nexus.Today()` (тайлангийн үе) өөр өдөр дээр ажиллана. Анхдагч нь
# Улаанбаатар; өөрчлөх шалтгаан нь зөвхөн өөр улсад суулгах явдал.
TZ=Asia/Ulaanbaatar

PUBLIC_ORIGIN=https://petronet.mn

# Төхөөрөмжийн шугамууд — native клиентүүдийн origin. Эдгээр нь ALLOWED_ORIGINS
# дээр PUBLIC_ORIGIN-ы хажууд нэмэгдэнэ (deploy/docker-compose.yml). Шугам нь
# vhost (`nginx/device-lines.petronet.mn.conf`) суугаад TLS гарсны дараа л
# ажиллана — бүртгэл ба асаах дараалал `native-apps/shared/device_lines.json`
# → `$provisioning`.
DEVICE_LINE_ORIGINS=https://desktop.petronet.mn,https://mobile.petronet.mn,https://kiosk.petronet.mn,https://pos.petronet.mn

# ---------------------------------------------------------------------- брэнд
# Хүсэлт бүр дээр уншигдана — образ биш, тохиргоо.
BRAND_NAME=PetroNet System
BRAND_SHORT_NAME=PetroNet
BRAND_DESCRIPTION=Шатахууны нөөцийн хяналт, удирдлагын нэгдсэн систем
BRAND_THEME_COLOR=#0f5a3c
# /opt/petronet/brand/ доторх файлууд, nginx-ээр /brand/… доор. Хоосон бол
# бүрхүүл образынхаа өөрийн зургийг үзүүлнэ.
BRAND_LOGO_URL=
BRAND_ICON_URL=
BRAND_MASKABLE_ICON_URL=

# --------------------------------------------------------------- газрын зураг
# Растер дэвсгэрийн эх сурвалж. Хоосон бол OpenStreetMap-ийн нийтийн сервер —
# тэр нь ТУРШИЛТЫН анхдагч: OSM-ийн журам их ачааллыг хориглодог бөгөөд улсын
# хэмжээний систем түүн дээр тогтвортой суурилах ёсгүй.
#
# Продакшнд өөрийн эсвэл гэрээт тайл сервер рүү заана. Клиент талд юу ч
# өөрчлөгдөхгүй: style нь энэ origin-ы /basemap/… -ыг л асуудаг.
MAP_RASTER_UPSTREAM=

# ------------------------------------------------------ хажуугийн үйлчилгээ
# Нүүр хуудсан дээр карт болж гарах, өөрийн хаягтай үйлчилгээнүүд. Хоосон
# орхисоныг нь зурахгүй — шийдэгддэггүй хостыг заасан карт нь картгүй байхаас
# дор.
#
# Зургаа нь бүгд байрандаа:
SERVICE_URL_EID=https://eidmongolia.mn
SERVICE_URL_ADMIN=https://admin.petronet.mn
SERVICE_URL_DWH=https://dwh.petronet.mn
SERVICE_URL_BACKUPS=https://backups.petronet.mn
SERVICE_URL_MONITOR=https://monitor.petronet.mn
SERVICE_URL_DOCS=https://docs.petronet.mn
# Толгойн «Баримт бичиг» цэс мөн үүнийг уншина. `BRAND_DOCS_URL` тавибал тэр
# нь давамгайлна; хоёулаа хоосон бол цэс нь цөмийн ерөнхий гарын авлага руу —
# өөр бүтээгдэхүүний ном руу — унана.

# ------------------------------------------------------------------ нэвтрэлт
# Танигдсан хэрнээ бүртгэлгүй хүнд данс үүсэх үү.
#
# public: eID-ээр танигдсан иргэн бүртгэлтэй болж, ӨӨРИЙН гэртээ буудаг
# (миграц 00085-аас хойш шинэ данс хэний ч байгууллагад ордоггүй).
# Байгууллагад нэгдэх нь тусдаа үйлдэл, тусдаа хариулттай.
#
# private: зөвхөн урьдчилан бүртгэгдсэн хүн. Консол энэ утгыг дийлнэ.
PLATFORM_ACCESS_MODE=public

# --------------------------------------------------------------- мониторинг
# Консол хэмжүүрээ хаанаас уншихыг заана. Стекийн өөрийн Prometheus —
# compose-ийн дотоод сүлжээгээр. Хоосон бол консолын тэр хэсэг
# «тохируулаагүй» гэж харагдана.
PROMETHEUS_URL=http://prometheus:9090
# Grafana — monitor.petronet.mn. Нууц үггүйгээр стек асахгүй.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
MONITORING_PUBLIC_URL=https://monitor.petronet.mn

# Харагдац ба хэл. Хоёулаа зөвхөн ӨГӨГДМӨЛ утга — хэрэглэгч бүр Grafana-ийн
# Profile → Preferences дотроос өөрөө сольж болно.
#
# Загвар: light, dark, эсвэл 12-оос хойш нэмэгдсэн desertbloom, gildedgrove,
# sapphiredusk, tron, gloom.
GRAFANA_DEFAULT_THEME=light
# Хэл: Grafana-д `mn` locale БАЙХГҮЙ тул монгол орчуулга нь `sv-SE`-ийн үүрэнд
# сууна — deploy/scripts/setup_monitor_branding.sh тэр chunk-ийг nginx дээр
# орлуулдаг. **Скриптийг ажиллуулаагүй хостод sv-SE бүү бич** — жинхэнэ швед
# хэл гарч ирнэ.
#
# Grafana шинэчлэгдэх бүрд chunk-ийн нэрэн дэх hash өөрчлөгддөг тул скриптийг
# дахин ажиллуулна; таарахгүй бол Grafana өөрийн файлаа өгч швед хэл эргэж
# ирнэ, өөр юу ч эвдрэхгүй.
GRAFANA_DEFAULT_LANGUAGE=sv-SE

# Платформын бүртгэлээр нэвтрэх. Унтраалттай үед Grafana зөвхөн дотоод
# админы нэвтрэлттэй үлдэнэ (тэр нь ямар ч үед буцаж орох зам хэвээр).
#
# Эхлээд клиентийг платформ дээр бүртгүүлнэ — Хөгжүүлэгч → Аппликейшн, эсвэл
# SQL-ээр (docs/OPERATIONS.md-ыг үз):
#
#   redirect_uris  https://monitor.petronet.mn/grafana/login/generic_oauth
#   grant_types    authorization_code, refresh_token
#   scopes         openid, profile, email, roles
#
# redirect URI-ийн хост нь OAUTH_REDIRECT_HOSTS дотор БАЙХ ёстой — тэр нь
# дэд домэйныг өвлүүлдэггүй тул monitor.petronet.mn бүтнээрээ бичигдэнэ.
GRAFANA_OAUTH_ENABLED=false
GRAFANA_OAUTH_NAME=PetroNet
GRAFANA_OAUTH_CLIENT_ID=
GRAFANA_OAUTH_CLIENT_SECRET=

# OIDC-ээр нэвтэрсэн хүнийг эргүүлж явуулж болох хостууд, таслалаар. Яг таарах
# нэрс: дэд домэйн өвлөгдөхгүй. Хоосон орхивол цөмийн анхдагч (nexus.gerege.mn)
# хүчинтэй болж, энэ суулгацын redirect бүр татгалзагдана.
OAUTH_REDIRECT_HOSTS=monitor.petronet.mn

# ---------------------------------------------------------------- eID Mongolia
# Энэ суулгацын relying-party итгэмжлэл. Хоосон бол нэвтрэх дэлгэцийн eID карт
# «session could not be started» гэж хариулна.
#
# Нэр ба бичвэр нь чимэглэл биш: иргэн апп дотроо яг тэдгээрийг уншаад
# зөвшөөрдөг. Цөмийн анхдагч нь «Gerege Nexus» тул хоосон орхивол хүнээс
# өөрийнх нь нээгээгүй зүйлд нэвтрэхийг зөвшөөр гэж гуйна.
#
# eID дээр энэ RP-д бүртгүүлсэн callback нь яг ${PUBLIC_ORIGIN}/auth/eid/callback
# байх ёстой — платформ өөр хост, өөр замыг дуудахаас нь өмнө татгалзана.
EID_RP_UUID=
EID_RP_SECRET=
EID_RP_NAME=PetroNet System
EID_DISPLAY_TEXT=PetroNet System-д нэвтрэх
EID_BASE_URL=https://eidmongolia.mn/v3
EID_MOCK_MODE=false

# ------------------------------------------------------------ Google нэвтрэлт
# Хоосон бол нэвтрэх дэлгэц Google товчгүй.
#
# Google Cloud Console → Credentials → OAuth 2.0 Client (Web) дээр бүртгэх
# redirect URI яг: ${PUBLIC_ORIGIN}/api/v1/auth/google/callback
# (зам нь цөмийн тогтмол — өөр зам бүртгэвэл Google татгалзана).
#
# Энэ нь коннектор (Drive, Meet) хэрэглэдэг GOOGLE_OAUTH_CLIENT_ID-аас
# ЗОРИУД тусдаа: коннектор асаах нь нэвтрэх шинэ хаалга нээх ёсгүй.
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
# Зөвшөөрөх и-мэйл домэйнууд, таслалаар. Хоосон бол домэйн шалгагдахгүй.
GOOGLE_LOGIN_ALLOWED_DOMAINS=
# Нэрлэсэн байгууллагын slug. Хоосон бол Google-ээр шинэ бүртгэл ҮҮСЭХГҮЙ —
# зөвхөн энд аль хэдийн байгаа данс руу нэвтэрнэ.
GOOGLE_LOGIN_TENANT=

# ------------------------------------------------------- операторын консол
# Консолын хаяг. Хоосон бол энэ суулгацад консол огт байхгүй (API нь
# /api/platform/v1 бүрд, бүрхүүл нь /cp дээр 404 хариулна).
# Нэршил: admin.<домэйн> — цөмийн docs/CONTROL_PLANE.md §3.1.
CONTROL_PLANE_HOST=admin.petronet.mn
# Authenticator апп дээр консолын кодын хажууд харагдах нэр. Хоосон бол
# «<BRAND_NAME> Control Plane». Консолын «Тохиргоо» → console.totp_issuer-ээс
# өөрчилж болно; зөвхөн шинээр бүртгүүлэх операторт хамаарна.
CONTROL_PLANE_TOTP_ISSUER=admin.petronet.mn

# ------------------------------------------------------------------ бусад
# Gerege Core бүртгэлийн токен. Байхгүй бол шидтэн болон байгууллагын дэлгэц
# регистрээр хайхын оронд гараар бөглөнө. Хаяг нь core.gerege.mn руу анхдагчаар.
GEREGE_CORE_TOKEN=

# ---------------------------------------------------------- шатахууны модуль
# Өдрийн эрхийг хоосон орхивол модуль 50,000₮-ийн policy default хэрэглэнэ.
FUEL_DAILY_GRANT_MNT=
